# Copy to .env.local (git-ignored) and fill in. All VITE_* values end up in the browser bundle,
# so only put public identifiers here (Firebase web config is not secret; real secrets belong in
# Cloudflare Worker / Firebase server-side config, never here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_FCM_VAPID_KEY=
VITE_PUSH_WORKER_URL=
VITE_ASSISTANT_WORKER_URL=
# Dev only. Leave EMPTY to skip App Check on localhost (fine while App Check is not enforced).
# If enforcement is enabled later: put any UUID here and register the same value in
# Firebase console -> App Check -> your web app -> Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
