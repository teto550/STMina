rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function isSignedIn() {
      return request.auth != null;
    }
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return isSignedIn() && myDoc().status == 'approved';
    }
    function isAdmin() {
      return isApproved() && myDoc().role == 'admin';
    }
    function isLead() {
      return isApproved() && myDoc().role == 'deacon' && myDoc().get('isLead', false) == true;
    }
    // 🆕 مسؤول مرحلة (نفس منطق التطبيق: isPhaseLead أو عنده phaseGrades)
    function isPhaseLead() {
      return isApproved()
        && (myDoc().get('isPhaseLead', false) == true
            || myDoc().get('phaseGrades', []).size() > 0);
    }

    // Servants block of a role (docs/ROLES-DESIGN.md): `users.access.servants` = ['male'] (خدام, the boys' section) and / or ['female']
    // (خادمات, the girls' section), written by the admin screen. Whoever holds it manages the servants of that section: here, reading and
    // deciding the pending join requests of that section.
    function managesServantsOf(section) {
      return isApproved() && (
        isAdmin()
        || (section == 'girls' ? 'female' : 'male') in myDoc().get('access', {}).get('servants', [])
      );
    }

    // The number of a class from its name; the cells of the roles are 'male:4' = gender:number (docs/ROLES-DESIGN.md). 0 = not a class name.
    function gradeNo(grade) {
      return {
        'سنة أولى ابتدائي': 1, 'سنة تانية ابتدائي': 2, 'سنة ثانية ابتدائي': 2, 'سنة تالتة ابتدائي': 3, 'سنة ثالثة ابتدائي': 3,
        'سنة رابعة ابتدائي': 4, 'سنة خامسة ابتدائي': 5, 'سنة سادسة ابتدائي': 6
      }.get(grade, 0);
    }

    // Do the roles of the signed-in servant (users.access.cells, written by the admin screen) give them this class? The boys' section is the
    // 'male' cell; the girls' section the 'female' cell, and in grades 1-2 (boys and girls together, served by women) either of the two.
    function rolesGiveClass(grade, section) {
      let n = gradeNo(grade);
      let cells = myDoc().access.get('cells', []);
      return n > 0 && (section == 'girls'
        ? (('female:' + string(n)) in cells || (n <= 2 && ('male:' + string(n)) in cells))
        : ('male:' + string(n)) in cells);
    }

    // May the signed-in person work on the things of a class (its parts of the programme)? An admin any class; a servant whose roles give them
    // the class; a servant with no roles yet (an old account) the class in their own `grade` field. Mirrors `canManageGrade` of the app.
    function worksOnClass(grade, section) {
      return isApproved() && (
        isAdmin()
        || ('cells' in myDoc().get('access', {})
            ? rolesGiveClass(grade, section)
            : myDoc().get('grade', '') == grade)
      );
    }

    // ===== users =====
    // كل واحد بيقرا ملفه بس، أو الأدمن يقرا الكل، أو أي معتمد يقرا حسابات المعتمدين
    // التانيين (محتاجينها لدليل الخدام)، أو مسؤول سنة يقرا طلبات "pending" بتاعة سنته
    match /users/{userId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isApproved() && resource.data.status == 'approved') ||
        (isLead() && resource.data.status == 'pending') ||
        // NO `.get(..., default)` here on purpose: for a list query the rule is checked against the query's own constraints, and a default
        // would let a query WITHOUT `where('section', '==', ...)` through and return the other section's requests too
        (resource.data.status == 'pending' && managesServantsOf(resource.data.section))
      );

      // التسجيل: يقدر ينشئ ملفه هو بس، وإجباريًا status=pending و role=deacon —
      // ممنوع حد يسجل نفسه admin أو approved من الأول
      // 🆕 وكمان ممنوع يسجل نفسه ومعاه isLead / isPhaseLead / phaseGrades
      // (عشان الصلاحيات دي مبقتش تتمنح إلا بعد موافقة الأدمن/المسؤول)
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role   == 'deacon'
        && request.resource.data.status == 'pending'
        && request.resource.data.email  == request.auth.token.email
        && !('isLead' in request.resource.data)
        && !('isPhaseLead' in request.resource.data)
        && !('phaseGrades' in request.resource.data);

      // التعديل: صاحب الحساب يعدل بياناته الشخصية بس (من غير ما يغيّر role/status/isLead
      // بنفسه)، أو الأدمن يعدل أي حاجة، أو مسؤول السنة يقبل/يرفض طلبات سنته بس
      // 🆕 صاحب الحساب كمان ممنوع يغيّر isPhaseLead / phaseGrades بنفسه
      // (من غير كده أي خادم كان يقدر يخلي نفسه مسؤول مرحلة ويشوف الباسوردات)
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role   == resource.data.role
            && request.resource.data.status == resource.data.status
            // `isLead` is not on a new account (the create rule forbids it), and reading a missing field is an ERROR in rules, which
            // denied EVERY self-edit of a servant who was never a lead (2026-10-16: the "complete your data" screen failed). `.get` with a default fixes that.
            && request.resource.data.get('isLead', false) == resource.data.get('isLead', false)
            && request.resource.data.get('isPhaseLead', false) == resource.data.get('isPhaseLead', false)
            && request.resource.data.get('phaseGrades', null)  == resource.data.get('phaseGrades', null)
            // roles design: the person link and the access snapshot are set by an admin only
            && request.resource.data.get('deaconId', null) == resource.data.get('deaconId', null)
            && request.resource.data.get('access', null)   == resource.data.get('access', null))
        || (isLead() && resource.data.grade == myDoc().grade
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('isLead', false) == resource.data.get('isLead', false))
        // whoever manages the servants of this section may approve or reject a pending request of it: only the status, and the link to
        // the person of the servants list; never the role, the access snapshot or anything else
        || (resource.data.status == 'pending'
            && managesServantsOf(resource.data.get('section', 'boys'))
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deaconId']));

      allow delete: if isAdmin();
    }

    // ===== roles (docs/ROLES-DESIGN.md): { name, admin, cells[] }; every approved account reads, only admins write =====
    match /roles/{roleId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ===== deacons (قايمة أسماء الخدام المعتمدة — بتتقرا في فورم التسجيل قبل ما يعمل حساب) =====
    match /deacons/{docId} {
      allow read: if true;              // لازم عشان تظهر في قايمة "الاسم الكامل" وقت التسجيل
      allow write: if isAdmin();
    }

    // ===== students =====
    match /students/{docId} {
      allow read, delete: if isApproved();

      // 🆕 إنشاء مخدوم: ممنوع حد غير الأدمن يحط kidId
      allow create: if isApproved()
        && (isAdmin() || (!('kidId' in request.resource.data) && !('photoLink' in request.resource.data)));

      // 🆕 تعديل: لو المخدوم عنده kidId ممنوع يتغير أو يتشال نهائيًا.
      // ولو معندوش، الأدمن بس هو اللي يضيفه (وقت رفع الشيت).
      // 🆕 photoLink (لينك الصورة من الشيت): نفس القاعدة — الأدمن بس يكتبه مرة واحدة، وبعدها ثابت لأي حد (أدمن أو خادم).
      allow update: if isApproved() && (
        ('kidId' in resource.data)
          ? request.resource.data.get('kidId', null) == resource.data.kidId
          : (isAdmin() || !('kidId' in request.resource.data))
      ) && (
        ('photoLink' in resource.data)
          ? request.resource.data.get('photoLink', null) == resource.data.photoLink
          : (isAdmin() || !('photoLink' in request.resource.data))
      );
    }

    // 🆕 ===== student_secrets (باسوردات المخدومين) =====
    // نفس id مستند المخدوم. الباسورد بيتسجل مرة واحدة من الأدمن ومبيتعدلش: ولا تعديل ولا حذف-وإعادة-كتابة، حتى من الأدمن.
    // بيتمسح بس مع المخدوم نفسه في نفس الدفعة (حذف المخدومين من تاب المخدومين): existsAfter بتقول إن ملف المخدوم اختفى بعد الدفعة.
    // أدمن بس يقراه (قرار الأدوار: مسؤول المرحلة مبقاش يشوف الباسوردات).
    match /student_secrets/{docId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.password is string;
      allow update: if false;
      allow delete: if isAdmin() && !existsAfter(/databases/$(database)/documents/students/$(docId));
    }

    // ===== attendance / deaconAttendance =====
    match /attendance/{docId} {
      allow read, write: if isApproved();
    }
    match /deaconAttendance/{docId} {
      allow read, write: if isApproved();
    }

    // ===== activity_log =====
    match /activity_log/{docId} {
      allow read: if isAdmin();
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== config =====
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 🆕 ===== parts_distribution (توزيع الفقرات) =====
    // كل خادم معتمد يقرا الفقرات. وأي خادم على الفصل ده (دوره بيديله الفصل، أو فصله هو لو لسه معندوش دور)، أو الأدمن، يقدر
    // يضيف ويعدّل ويمسح فقرات الفصل ده (worksOnClass): نفس منطق canManageGrade في التطبيق، اتطبّق هنا كمان عشان محدّش يتحايل على التطبيق.
    match /parts_distribution/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && (
        worksOnClass(request.resource.data.grade, request.resource.data.get('section', 'boys')) ||
        (isLead() && myDoc().grade == request.resource.data.grade) ||
        (isPhaseLead() && request.resource.data.grade in myDoc().get('phaseGrades', []))
      ) && request.resource.data.createdByUid == request.auth.uid;
      allow delete: if isApproved() && (
        worksOnClass(resource.data.grade, resource.data.get('section', 'boys')) ||
        (isLead() && myDoc().grade == resource.data.grade) ||
        (isPhaseLead() && resource.data.grade in myDoc().get('phaseGrades', []))
      );
      // editing a part (give it its type / servant later, change the day, the title or the reference; the admin screen also renames the servant): the
      // manager of the class (or an admin), and only these fields: never the class, the section or who created it
      allow update: if isApproved() && (
        worksOnClass(resource.data.grade, resource.data.get('section', 'boys')) ||
        (isLead() && myDoc().grade == resource.data.grade) ||
        (isPhaseLead() && resource.data.grade in myDoc().get('phaseGrades', []))
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'title', 'date', 'reference', 'deaconName', 'deaconId', 'updatedAt']);
    }

    // ===== occasions: the Christian occasions (feasts, fasts), ONE list for every class: { title, date } =====
    // every approved account reads (a list query must be a range on `date`: one year at a time); only an admin writes
    match /occasions/{occasionId} {
      allow read: if isApproved();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'date'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if isAdmin();
    }

    // أي حاجة تانية غير كده: ممنوعة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
